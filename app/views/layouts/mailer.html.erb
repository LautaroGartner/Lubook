<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Lubook</title>
  </head>

  <body style="margin:0;background:#fafaf9;color:#292524;font-family:Arial,sans-serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#fafaf9;padding:32px 16px;">
      <tr><td align="center">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;">
          <tr><td style="padding:0 0 20px;text-align:center;font-family:Georgia,serif;font-size:30px;font-weight:bold;color:#be123c;">Lubook</td></tr>
          <tr><td style="background:#ffffff;border:1px solid #e7e5e4;border-radius:10px;padding:36px 32px;line-height:1.6;">
            <%= yield %>
          </td></tr>
          <tr><td style="padding:20px 16px 0;text-align:center;color:#78716c;font-size:12px;line-height:1.5;">
            A quiet corner of the internet for people you actually like.<br>
            This is an automated message from Lubook.
          </td></tr>
        </table>
      </td></tr>
    </table>
  </body>
</html>
