<div class="relative" data-controller="password-visibility">
  <%= form.password_field field,
        **options,
        class: "#{options[:class]} pr-16",
        data: (options[:data] || {}).merge(password_visibility_target: "input") %>
  <button type="button"
          class="absolute inset-y-0 right-0 px-3 text-sm font-medium text-stone-500 hover:text-rose-600 focus:outline-none focus:text-rose-600"
          data-action="password-visibility#toggle"
          data-password-visibility-target="button"
          aria-label="Show password"
          aria-pressed="false">Show</button>
</div>
